<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #f9f9f9;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="com.yazidsistems.app.tema_4.controller.InventariosController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <children>
        <Label text="Optimización de Inventarios (Modelo EOQ)" textFill="#2c3e50">
            <font>
                <Font name="Arial Bold" size="18.0" />
            </font>
        </Label>

        <!-- Formulario de Entrada de Datos -->
        <GridPane hgap="10.0" vgap="10.0">
            <children>
                <Label text="Demanda Anual (D - unidades):" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <TextField fx:id="txtDemanda" promptText="Ej. 1200" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Costo por Pedido (S - $ / orden):" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <TextField fx:id="txtCostoPedido" promptText="Ej. 25" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Costo de Mantener (H - $ / unidad / año):" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <TextField fx:id="txtCostoMantener" promptText="Ej. 3" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <Button fx:id="btnCalcular" mnemonicParsing="false" onAction="#calcularInventario" prefWidth="120.0" style="-fx-background-color: #27ae60; -fx-text-fill: white;" text="Calcular EOQ" />

        <!-- Panel de Resultados -->
        <VBox spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #bdc3c7; -fx-border-radius: 5; -fx-padding: 15;">
            <children>
                <Label text="Resultados del Análisis:">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Label>
                <Label fx:id="lblLoteOptimo" text="Cantidad Óptima de Pedido (Q*): -" />
                <Label fx:id="lblPedidosAnuales" text="Número de pedidos al año: -" />
                <Label fx:id="lblCostoOrdenar" text="Costo anual de ordenar: $ -" />
                <Label fx:id="lblCostoMantener" text="Costo anual de mantener: $ -" />
                <Label fx:id="lblCostoTotal" text="Costo Total Anual de Inventario: $ -" style="-fx-font-weight: bold;" />
            </children>
        </VBox>

        <Label fx:id="lblError" textFill="#e74c3c" wrapText="true" />
    </children>
</VBox>
